# Copy to .env.local and fill from CBAware / Vercel / Google Cloud.
# Same Supabase project as Aware. Never commit .env.local.

# Google OAuth (reuse Aware client; add redirect URIs for this game)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
NEXTAUTH_SECRET=
# Local: http://localhost:3000
# Prod:  https://<your-vercel-domain>
NEXTAUTH_URL=http://localhost:3000

# Shared CBAware Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — from Supabase → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=
